PORT=3000

# Dùng MongoDB Atlas (cloud miễn phí, không cần cài MongoDB):
# 1. Đăng ký tại https://cloud.mongodb.com
# 2. Tạo cluster M0 Free → Connect → Drivers → copy URI
# 3. Thay YOUR_PASSWORD và cluster URL bên dưới
MONGODB_URI=mongodb+srv://xanhla:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/xanh-la?retryWrites=true&w=majority

# Hoặc nếu đã cài MongoDB local:
# MONGODB_URI=mongodb://localhost:27017/xanh-la

JWT_SECRET=xanhla_dev_secret_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
